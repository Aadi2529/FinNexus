# Environment Configuration Example for FinNexus Backend
# Copy to .env for local overrides (never commit real secrets)

NODE_ENV=development
PORT=8000
DEBUG=true
PROJECT_NAME="FinNexus"
API_V1_PREFIX="/api/v1"

# Modular Database Configuration (Recommended)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=finnexus_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SCHEMA=public

# Or specify full database URLs directly (Optional, overrides DB_* above if specified):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/finnexus_db
# SYNC_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/financeflow_dev

# Redis Configuration (Optional in local development; thread-safe in-memory cache is used when offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379/0

# JWT & Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Super Admin Initial Seeder (Populated when running `python -m app.db.seed`)
SUPER_ADMIN_EMAIL=admin@financeflow.com
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_FIRST_NAME=Aditya
SUPER_ADMIN_LAST_NAME=Thakre

# Health Check Probe Timeouts (seconds)
DB_HEALTH_TIMEOUT=3.0
REDIS_HEALTH_TIMEOUT=3.0
